{
  "name": "osmo-bridge-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "format": "prettier --write src",
    "qa:build": "tsc -b && vite build --mode test --outDir ../.cache/frontend-qa",
    "qa:preview": "vite preview --outDir ../.cache/frontend-qa --host 127.0.0.1 --port 34182 --strictPort"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@wailsio/runtime": "3.0.0-beta.34",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "1.57.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
